# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the real values:  cp .env.example .env
# .env is git-ignored. Never commit real IDs or tokens.
# ---------------------------------------------------------------------------

# Your Sanity project ID. Find it at https://sanity.io/manage (top of the project page).
PUBLIC_SANITY_PROJECT_ID=your-project-id

# The dataset to read content from. A new Sanity project starts with "production".
PUBLIC_SANITY_DATASET=production

# The dated Sanity API version to pin to. Leave as-is unless you have a reason to change it.
PUBLIC_SANITY_API_VERSION=2024-10-01

# Editor token, used ONLY by `npm run seed`. Create one at
# sanity.io/manage -> API -> Tokens -> Add API token, with "Editor" permissions.
# The public site never reads this, so it does not go on Netlify.
SANITY_API_WRITE_TOKEN=
