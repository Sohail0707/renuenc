---
// Hero + trust strip — markup copied verbatim from the original index.html.
// Only the image path changed (public/ is served from the root).
---
<!-- ================= 3. HERO ================= -->
<section class="hero" aria-labelledby="hero-title">
  <!-- Explicit width/height on the image reserves the aspect box, so no CLS on load. -->
  <img class="hero__img" src="/images/hero-ballroom.jpg" width="2560" height="1654"
       alt="" aria-hidden="true" fetchpriority="high" decoding="async">
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__content">
      <p class="eyebrow">Protect Your Investment. Restore Your Shine.</p>
      <h1 id="hero-title">Expert Commercial Deep Cleaning Services in North Carolina</h1>
      <p class="hero__sub">
        Refreshed, healthy spaces that protect your guests, your brand, and the life of
        your assets. Serving hotels and commercial properties across NC since 1991.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#">Get a Free Quote</a>
        <a class="btn btn--ghost" href="#">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1l-2.22 2.2Z"/>
          </svg>
          Call 919-307-1778
        </a>
      </div>
    </div>
  </div>

  <!-- ================= 4. TRUST STRIP ================= -->
  <div class="trust">
    <div class="trust__inner">
      <p class="trust__label">Preferred deep cleaning partner for</p>
      <ul class="trust__brands">
        <li>Marriott</li>
        <li>IHG</li>
        <li>Best Western</li>
        <li>Avendra</li>
      </ul>
    </div>
  </div>
</section>
