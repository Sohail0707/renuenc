---
import type {ChecklistGrid} from '../../lib/types'

interface Props {
  section: ChecklistGrid
}

const {section} = Astro.props

const columns = section.columns === 'two' ? 'two' : 'three'
const items = (section.items ?? []).filter((item) => typeof item === 'string' && item.trim() !== '')
---
<section class="section section--white">
  <div class="section__inner">
    <div class="section__head">
      {section.heading && <h2 class="section__heading">{section.heading}</h2>}
      {section.intro && <p class="section__intro">{section.intro}</p>}
    </div>

    {items.length > 0 && (
      <ul class={`checklist checklist--${columns}`}>
        {items.map((item) => (
          <li>
            <svg class="tick" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1.1 14.3-4-4 1.5-1.5 2.5 2.5 5.2-5.2 1.5 1.5-6.7 6.7Z"/>
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
