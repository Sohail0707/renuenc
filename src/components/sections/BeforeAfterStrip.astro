---
import {croppedUrl} from '../../lib/sanity'
import type {BeforeAfterStrip} from '../../lib/types'

interface Props {
  section: BeforeAfterStrip
}

const {section} = Astro.props

const shots = (section.images ?? []).filter((shot) => shot?.image)
---
<section class="section section--white">
  <div class="section__inner">
    <div class="section__head">
      {section.heading && <h2 class="section__heading">{section.heading}</h2>}
      {section.intro && <p class="section__intro">{section.intro}</p>}
    </div>

    {shots.length > 0 && (
      <div class="strip">
        {shots.map((shot) => (
          <figure class="strip__shot">
            <img
              src={croppedUrl(shot.image!, 1000, 750)}
              width="1000"
              height="750"
              alt={shot.alt ?? ''}
              loading="lazy"
              decoding="async"
            />
            {shot.alt && <figcaption>{shot.alt}</figcaption>}
          </figure>
        ))}
      </div>
    )}
  </div>
</section>
